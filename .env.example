# Shopify Admin API Configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_ENVIRONMENT=production

# Required API Scopes:
# read_products, write_products      (products, collections, tags)
# read_publications, write_publications  (sales-channel publishing)
# read_orders, write_orders
# read_customers, write_customers
# read_inventory, write_inventory
# read_locations
#
# Note: collection and tag tools both live under write_products.
# publication_list / product_publish_* require write_publications.
